# GACP Frontend Dockerfile
# Build from Root Context (to access shared Prisma schema)

# ===========================================
# Stage 1: Builder
# ===========================================
FROM node:20-alpine AS builder
WORKDIR /app

# Install pnpm and dependencies (openssl needed for prisma)
# pnpm is PINNED to the same major as packageManager in root package.json
# (pnpm@8.15.0) — the backend Dockerfile documents why: the lockfile was
# generated by pnpm 8, and an unpinned install now resolves pnpm 10, which
# fails `--frozen-lockfile` with ERR_PNPM_PNPM_ENGINE_IDENTITY_UNVERIFIABLE
# (hit for real building staging-a593ee88 on 2026-09-06).
RUN apk add --no-cache openssl libc6-compat && npm install -g pnpm@8

# Copy root configurations
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# Copy Backend Package config (Critical for pnpm workspace resolution)
COPY apps/backend/package.json ./apps/backend/package.json

# Copy Backend Prisma (Shared Schema)
COPY apps/backend/prisma ./apps/backend/prisma

# Copy shared packages (workspace dependencies)
COPY packages ./packages

# Copy Web App
COPY apps/web-app ./apps/web-app

# Install Dependencies (using pnpm)
RUN pnpm install --frozen-lockfile

# Generate Prisma Client (referencing schema in ../backend/prisma)
WORKDIR /app/apps/web-app
RUN npx prisma generate --schema=../backend/prisma/schema

# Environment variables for build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

ARG NEXT_PUBLIC_WEB_URL
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL
# ตัวตนของหน่วยงาน — Next ฝังค่าเหล่านี้ลงบันเดิลตอน build จึงต้องมาถึงตรงนี้
ARG NEXT_PUBLIC_ORG_NAME
ENV NEXT_PUBLIC_ORG_NAME=$NEXT_PUBLIC_ORG_NAME
ARG NEXT_PUBLIC_ORG_NAME_EN
ENV NEXT_PUBLIC_ORG_NAME_EN=$NEXT_PUBLIC_ORG_NAME_EN
ARG NEXT_PUBLIC_ORG_PHONE
ENV NEXT_PUBLIC_ORG_PHONE=$NEXT_PUBLIC_ORG_PHONE
ARG NEXT_PUBLIC_ORG_EMAIL
ENV NEXT_PUBLIC_ORG_EMAIL=$NEXT_PUBLIC_ORG_EMAIL
ARG NEXT_PUBLIC_ORG_ADDRESS
ENV NEXT_PUBLIC_ORG_ADDRESS=$NEXT_PUBLIC_ORG_ADDRESS
ARG NEXT_PUBLIC_ORG_WEBSITE
ENV NEXT_PUBLIC_ORG_WEBSITE=$NEXT_PUBLIC_ORG_WEBSITE
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ARG NEXT_PUBLIC_PWA_ENABLED=false
ENV NEXT_PUBLIC_PWA_ENABLED=${NEXT_PUBLIC_PWA_ENABLED}

# Checkout UI feature flag. `next build` INLINES every NEXT_PUBLIC_* it finds
# into the client bundle, so this must exist in the BUILDER stage — setting it on
# the running container changes nothing about an already-compiled bundle.
#
# It was absent from this file entirely until 2026-08-14 while
# docs/operations/runbooks/deploy-staging-manual.md:26,75 told operators to bake
# it into the staging image at build time. Passing --build-arg for an ARG that
# does not exist is not an error to docker: it prints a warning at the end of a
# ten-minute build and produces an image with the flag off. So the runbook's
# instruction could be followed exactly and still yield a checkout page that
# 404s, with nothing in the output pointing at why.
#
# Default TRUE since 2026-08-27. isCheckoutUiEnabled() (src/lib/config/checkout-mode.ts)
# still fails closed on anything but the exact string 'true' — that contract is
# unchanged — but the DEFAULT that reaches it from an image build is now on,
# because with payment slips retired the checkout is the ONLY door through which
# an applicant can pay: an image built with the flag off is a silent outage of
# the money path (ledger UX-9 / F-G4 walk: the payments screen drew no amount,
# no button, no message). Switching it OFF is the deliberate act now, done with
# apps/web-app/.env.example.

# Build the application (skip linting)
RUN pnpm exec next build --no-lint

# ===========================================
# Stage 2: Production Runner
# ===========================================
FROM node:20-alpine AS runner
WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache libc6-compat

# Security: Run as non-root user
RUN addgroup -g 1001 nodejs && \
    adduser -u 1001 -G nodejs -D nextjs

# Set environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ARG NEXT_PUBLIC_PWA_ENABLED=false
ENV NEXT_PUBLIC_PWA_ENABLED=${NEXT_PUBLIC_PWA_ENABLED}

# Copy standalone build
# This preserves the monorepo structure, putting server.js at ./apps/web-app/server.js
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-app/.next/standalone ./

# Copy public assets to the correct nested location
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-app/public ./apps/web-app/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web-app/.next/static ./apps/web-app/.next/static

# Build identity, read back out by GET /api/version via src/lib/build-info.ts.
#
# RUNNER STAGE ONLY, and after the COPYs. Declaring these in the builder stage
# would put the value into the compiled output rather than the server process's
# environment, and the route reads process.env at request time. Placing them
# after the COPYs keeps the layer cache: their value changes on every commit, so
# anything below them rebuilds every time, and everything expensive — pnpm
# install, prisma generate, next build — is in the stage above.
#
# Left unset they expand to "", which build-info.ts normalises to null. That is
# deliberate: an image that cannot say which commit it is must say so, rather
# than answer with a placeholder that reads as a different commit.
ARG GIT_SHA=""
ARG BUILT_AT=""
ENV GIT_SHA=${GIT_SHA}
ENV BUILT_AT=${BUILT_AT}

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Start application pointing to the nested server.js
CMD ["node", "apps/web-app/server.js"]
