/// ค่าธรรมเนียมที่เจ้าหน้าที่ยืนยันว่ารับแล้ว
///
/// ระบบเต็มมี 21 โมเดลฝั่งการเงิน (ใบเสนอราคา ใบแจ้งหนี้ ใบเสร็จ สลิป สมุดรายวัน
/// การกระทบยอด Stripe ฯลฯ) เพราะมันรับเงินเอง · GACP Lite ไม่รับเงิน — ลูกค้าเก็บเงิน
/// ด้วยช่องทางของตัวเอง แล้วเจ้าหน้าที่บันทึกว่ารับแล้ว (คำตัดสิน operator 2026-09-08)
///
/// สิ่งที่แถวนี้ตอบได้ และเป็นเหตุผลเดียวที่มันมีอยู่: **ใครเป็นคนบอกว่าเงินเข้าแล้ว
/// เมื่อไร จำนวนเท่าไร และอ้างอิงอะไร** — คำขอเดินต่อไม่ได้ถ้าไม่มีแถวนี้ และแถวนี้
/// ชี้ตัวคนที่ต้องรับผิดชอบได้เสมอ · ไม่มีใครลบได้ (ไม่มี soft delete โดยตั้งใจ)
model FeePayment {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid

  /// PHASE_1 = ค่าตรวจเอกสาร · PHASE_2 = ค่าตรวจแปลง
  /// เป็น String ไม่ใช่ enum เพราะทั้งระบบใช้ String กับ vocabulary อื่นเหมือนกัน
  /// และ CHECK constraint ใน migration เป็นตัวคุมคำ
  phase String

  /// บาท (ไม่ใช่สตางค์) — ตรงหน่วยกับ Application.phase1Amount / phase2Amount
  amountThb Int

  /// เลขที่อ้างอิงจากช่องทางที่ลูกค้าใช้เก็บเงินจริง (เลขที่ใบเสร็จ, transaction id,
  /// เลขที่หนังสือนำส่ง) · ระบบไม่ตรวจสอบค่านี้และไม่ควรแสร้งว่าตรวจ — มันคือสิ่งที่
  /// เจ้าหน้าที่พิมพ์เพื่อให้ตามกลับไปที่หลักฐานตัวจริงได้
  externalReference String?

  /// หมายเหตุของเจ้าหน้าที่ (เช่น รับเป็นเงินสด, โอนวันที่ ...)
  note String?

  /// เจ้าหน้าที่ผู้ยืนยัน — ไม่ใช่ผู้จ่าย
  confirmedById String   @db.Uuid
  confirmedAt   DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  confirmedBy User        @relation("FeePaymentConfirmedBy", fields: [confirmedById], references: [id])

  /// หนึ่งงวด ยืนยันได้ครั้งเดียว — กันการกดซ้ำและกันการเดินสถานะซ้ำ
  @@unique([applicationId, phase])
  @@index([confirmedAt])
  @@map("fee_payments")
}
