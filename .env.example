# GACP Lite — คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าให้ครบก่อน `docker compose up -d`
#
# สามค่าแรกไม่มีค่าเริ่มต้นโดยตั้งใจ: ระบบที่บูตขึ้นด้วยรหัสผ่านที่ทุกคนเดาได้
# แย่กว่าระบบที่ไม่ยอมบูตแล้วบอกว่าต้องตั้งอะไร

# ─── ฐานข้อมูล ───────────────────────────────────────────────────────────────
POSTGRES_USER=gacp
POSTGRES_PASSWORD=
POSTGRES_DB=gacp_lite

# ─── ความลับของแอป ──────────────────────────────────────────────────────────
# สร้างด้วย: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# ต้องยาว 32 ไบต์พอดี (hex 64 ตัว): openssl rand -hex 32
# ใช้เข้ารหัสเลขบัตรประชาชนและข้อมูลส่วนบุคคลในฐานข้อมูล — เปลี่ยนแล้วอ่านของเก่าไม่ออก
ENCRYPTION_KEY=

# ─── ตัวตนของหน่วยงานที่ติดตั้งระบบนี้ ───────────────────────────────────────
# ไม่ตั้ง = ระบบจะพิมพ์ชื่อ เบอร์ และอีเมลของ "กรมการแพทย์แผนไทยและการแพทย์ทางเลือก"
# (เจ้าของระบบต้นทาง) ลงบนใบรับรอง หน้าติดต่อ อีเมลแจ้งเตือน และท้ายทุกหน้า
# ซึ่งแปลว่าระบบของคุณบอกผู้ใช้ของคุณให้ติดต่อหน่วยงานอื่น
ORG_NAME=
ORG_NAME_EN=
ORG_PHONE=
ORG_EMAIL=
ORG_ADDRESS=
ORG_WEBSITE=

# ค่าเดียวกันสำหรับหน้าจอ — Next อ่านตอน build จึงต้องส่งเป็น build arg ด้วย
# (docker-compose.yml ส่งให้แล้ว ถ้า build เอง ต้องตั้งตอน build)
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_ORG_NAME_EN=
NEXT_PUBLIC_ORG_PHONE=
NEXT_PUBLIC_ORG_EMAIL=
NEXT_PUBLIC_ORG_ADDRESS=
NEXT_PUBLIC_ORG_WEBSITE=

# ─── ที่อยู่ที่ผู้ใช้เปิดจริง ──────────────────────────────────────────────────
# ถ้าขึ้นโดเมนจริงให้แก้สองค่านี้ ไม่งั้น CORS จะปฏิเสธเบราว์เซอร์ของผู้ใช้เอง
# โหมด production ไม่มีโดเมนเริ่มต้นใด ๆ โดยตั้งใจ — ไม่ตั้ง = ปฏิเสธทุกที่มา
PUBLIC_WEB_URL=http://localhost:3100
PUBLIC_API_URL=http://localhost:8100

# ─── พอร์ต (แก้เมื่อชนกับของอื่นบนเครื่องเดียวกัน) ─────────────────────────────
WEB_PORT=3100
API_PORT=8100
DB_PORT=55460
